# ==================================================
# VATSALYA (वात्सल्य) — Environment Configuration Template
# Placeholders only. NEVER commit real secrets or .env.local
# ==================================================

# 1. Supabase (Database, Auth, Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key-placeholder

# 2. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Scheduled Jobs & Security
CRON_SECRET=your_secure_random_cron_secret_placeholder

# 4. Delivery Channel B: Official Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_placeholder
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token_placeholder

# 5. Delivery Channel C: Resend Transactional Email
RESEND_API_KEY=re_123456789_placeholder
RESEND_FROM_EMAIL=reminders@vatsalya.care

# 6. Delivery Channel A: Android Firebase Cloud Messaging (FCM)
# Required when Android client registration is linked to FCM
FCM_PROJECT_ID=vatsalya-healthcare
FCM_CLIENT_EMAIL=firebase-adminsdk@vatsalya-healthcare.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...placeholder\n-----END PRIVATE KEY-----\n"

# 7. AI & Voice Integrations
GEMINI_API_KEY=AIzaSy...your-gemini-api-key-placeholder
GNANI_API_KEY=your_gnani_api_key_placeholder
